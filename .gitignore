__pycache__/
*.pyc

# Local tooling state, not part of the site
.claude/
.claude-flow/

# Local helper scripts and their output. push.bat does `git add -A`, so it
# would otherwise sweep itself and its log into a commit.
# cleanup-git-locks.bat is deliberately left out: it is already tracked, and
# ignoring a tracked file has no effect.
push.bat
push_log.txt

# Local tooling state, test copies of the page (sign-in bypassed), local
# helper scripts and their output, secrets and OS clutter
_test_ws.html
node_modules/
.env
.env.*
.DS_Store
Thumbs.db

# Smoke check output
test-results/
playwright-report/

[OK] Command outcome recorded

# Stray 0-byte files. A fragment of JavaScript can reach cmd.exe, which reads
# the ">" in an "=>" arrow as an output redirection and drops an empty file
# named after the next token. Harmless alone, but a broad `git add` commits
# them. Anchored with a leading "/" so they apply to the repo root only, where
# these land; no legitimate file here carries these characters. A literal "["
# is written "[[]" because bare brackets open a character class.
/*(*
/*)*
/*[[]*
/*]*
/*{*
/*}*
/*$*
/*'*
/*`*
/*%*
/*=*
/*#*
